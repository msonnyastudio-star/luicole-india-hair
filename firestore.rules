rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAcceptedMember(groupId) {
      return signedIn() && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == 'accepted';
    }
    function isGeneralAdmin() {
      return signedIn() && (
        request.auth.token.email == 'kerenetchapga@gmail.com'
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['general_admin', 'payment_manager']
      );
    }

    match /groups/{groupId} {
      allow get: if isGeneralAdmin()
        || isAcceptedMember(groupId)
        || (resource.data.privacy in ['public', 'discoverable'] && resource.data.status == 'funding');
      // A creator can recover their own groups after reconnecting. The client
      // query is constrained with where('creatorId', '==', request.auth.uid).
      allow list: if isGeneralAdmin()
        || (resource.data.privacy in ['public', 'discoverable'] && resource.data.status == 'funding')
        || (signedIn() && resource.data.creatorId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      // Financial totals and completion status are protected by the admin
      // confirmation transaction.
      allow update: if isGeneralAdmin();
      allow delete: if isGeneralAdmin() || (signedIn() && resource.data.creatorId == request.auth.uid);

      match /members/{userId} {
        // A member can read the member list of a group they belong to.  The
        // second condition is deliberately based on document data: it lets
        // Firestore safely run the collection-group query used to find *my*
        // memberships, without exposing anybody else's memberships.
        allow get: if isAcceptedMember(groupId)
          || get(/databases/$(database)/documents/groups/$(groupId)).data.privacy in ['public', 'discoverable']
          || (signedIn() && userId == request.auth.uid);
        allow list: if isAcceptedMember(groupId)
          || get(/databases/$(database)/documents/groups/$(groupId)).data.privacy in ['public', 'discoverable']
          || (signedIn() && resource.data.userId == request.auth.uid);
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.status == 'accepted'
          && (
            getAfter(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid
            || getAfter(/databases/$(database)/documents/groups/$(groupId)).data.privacy in ['public', 'discoverable']
            || (
              request.resource.data.inviteCode is string
              && getAfter(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)).data.groupId == groupId
            )
          );
        allow update, delete: if isGeneralAdmin() || (isAcceptedMember(groupId) && get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid);
      }
      match /contributions/{contributionId} {
        allow read: if isGeneralAdmin() || (signedIn() && resource.data.memberId == request.auth.uid);
        allow create: if isAcceptedMember(groupId)
          && get(/databases/$(database)/documents/groups/$(groupId)).data.status == 'funding'
          && request.resource.data.memberId == request.auth.uid
          && request.resource.data.status == 'declared'
          && request.resource.data.proofId == contributionId
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.reference is string
          && request.resource.data.reference.size() >= 4
          && (
            (
              request.resource.data.paymentMethod == 'orange'
              && request.resource.data.recipientNumber == '+237657946480'
              && request.resource.data.recipientName == 'Assom Nang Galine'
            )
            || (
              request.resource.data.paymentMethod == 'mtn'
              && request.resource.data.recipientNumber == '+237654884748'
              && request.resource.data.recipientName == 'Tchapga Gaetan'
            )
          )
          && getAfter(/databases/$(database)/documents/paymentProofs/$(contributionId)).data.uploaderId == request.auth.uid
          && getAfter(/databases/$(database)/documents/paymentProofs/$(contributionId)).data.groupId == groupId;
        allow update: if isGeneralAdmin();
        allow delete: if isGeneralAdmin() || (signedIn() && get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid);
      }
      match /messages/{messageId} {
        allow read: if isAcceptedMember(groupId);
        allow create: if isGeneralAdmin()
          || (isAcceptedMember(groupId) && request.resource.data.authorId == request.auth.uid && request.resource.data.system == false)
          || (isAcceptedMember(groupId) && request.resource.data.system == true && get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid);
        allow update: if isGeneralAdmin() || (isAcceptedMember(groupId) && resource.data.authorId == request.auth.uid && request.time < resource.data.createdAt + duration.value(15, 'm'));
        allow delete: if isGeneralAdmin()
          || (isAcceptedMember(groupId) && resource.data.authorId == request.auth.uid)
          || (signedIn() && get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid);
      }
    }
    match /users/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow create: if signedIn() && userId == request.auth.uid && request.resource.data.role == 'customer';
      allow update: if signedIn() && userId == request.auth.uid && request.resource.data.role == resource.data.role;

      // Private per-user registry used to load "Mes groupes" reliably. The
      // group member document remains the authority for all private content.
      match /groupMemberships/{groupId} {
        allow read: if signedIn() && userId == request.auth.uid;
        allow delete: if (signedIn() && userId == request.auth.uid)
          || isGeneralAdmin()
          || (signedIn()
            && resource.data.groupId is string
            && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.creatorId == request.auth.uid);
        allow create, update: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.groupId == groupId
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == 'accepted';
      }
    }
    match /groupInvites/{inviteCode} {
      // An invitation code is only useful when it has been explicitly shared.
      // Listing is forbidden; the code must be known exactly to be read.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.inviteCode == inviteCode;
      allow update, delete: if isGeneralAdmin() || (signedIn() && resource.data.creatorId == request.auth.uid);
    }
    match /paymentProofs/{proofId} {
      allow create: if signedIn()
        && request.resource.data.proofId == proofId
        && request.resource.data.contributionId == proofId
        && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.groupId is string
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 750000
        && request.resource.data.size is number
        && request.resource.data.size > 0
        && request.resource.data.size <= 460800
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/contributions/$(proofId)).data.memberId == request.auth.uid;
      // test-compat: allow read, update, delete: if isGeneralAdmin();
      allow read, update: if isGeneralAdmin();
      allow delete: if isGeneralAdmin()
        || (signedIn()
          && resource.data.groupId is string
          && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.creatorId == request.auth.uid);
    }
    match /paymentReferences/{referenceId} {
      allow read, write: if isGeneralAdmin();
    }
    match /products/{productId} {
      allow get: if resource.data.published == true || isGeneralAdmin();
      allow list: if resource.data.published == true || isGeneralAdmin();
      allow create, update, delete: if isGeneralAdmin();
    }
    // Ancien document conservé uniquement pour la migration des prix.
    match /catalog_prices/{doc} {
      allow read: if true;
      allow write: if isGeneralAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
